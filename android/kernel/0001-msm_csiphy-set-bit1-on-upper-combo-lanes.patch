 					lane_val = 0x4;
+				/*
+				 * The original Lumia iris driver also sets bit 1
+				 * on both upper combo lanes (lane 3 = 0x6,
+				 * lane 4 = 0xa). Without it the upper pair
+				 * delivers no packets to the CSID.
+				 */
+				if (j >= 3 && ((csiphy_params->lane_mask &
+						0x18) == 0x18))
+					lane_val |= 0x2;
 			}
